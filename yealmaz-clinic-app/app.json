{
  "expo": {
    "name": "Ye-Almaz Clinic",
    "slug": "yealmaz-clinic",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E9F6E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yealmaz.clinic",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take photos of payment screenshots",
        "NSPhotoLibraryUsageDescription": "Used to upload payment screenshots from your gallery"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E9F6E"
      },
      "package": "com.yealmaz.clinic",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Ye-Almaz Clinic",
      "shortName": "Ye-Almaz",
      "description": "Ye-Almaz Dental Laboratory — Clinic Portal",
      "themeColor": "#0E9F6E",
      "backgroundColor": "#0E9F6E",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "en",
      "startUrl": "/"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ye-Almaz Clinic to access your photos to upload payment screenshots.",
          "cameraPermission": "Allow Ye-Almaz Clinic to use your camera to take payment photos."
        }
      ],
      "expo-web-browser",
      "expo-font"
    ]
  }
}
