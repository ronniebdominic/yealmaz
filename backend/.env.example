# ── Ye-Almaz Dental Lab — Backend Environment Variables ──
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Database (get from Supabase → Settings → Database → Connection string → URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# JWT Secret (make up any long random string, e.g. yealmaz_super_secret_2024_xk92mz)
JWT_SECRET="yealmaz_super_secret_change_this"
JWT_EXPIRES_IN="7d"

# Cloudinary (get from cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS — update when deployed)
FRONTEND_URL="http://localhost:3000"

# App URL (used in QR codes — update when deployed)
APP_URL="http://localhost:5000"

# Chapa payment gateway (get from https://dashboard.chapa.co → Settings → API Keys)
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=

# Web Push (VAPID keys — generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@yealmaz.com

# Biometric attendance device callback secret (no device connected yet)
ATTENDANCE_DEVICE_SECRET=

# Self-service geofenced attendance (delivery agents) — lab building's
# coordinates and the radius (meters) within which clock-in/out is allowed
LAB_LATITUDE=
LAB_LONGITUDE=
ATTENDANCE_RADIUS_METERS=150

# Telegram business Q&A bot — read-only, answers questions about cases/
# payments/performance in Telegram. Full setup runbook: docs/telegram-bot-setup.md
# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Any long random string — verified against Telegram's own secret_token
# mechanism on every webhook delivery
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram chat IDs allowed to use the bot (message
# @userinfobot on Telegram to find yours) — this is the bot's entire
# access boundary, independent of the app's normal login/roles
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional — cron expression for the daily digest push, default 8am daily
# (Africa/Addis_Ababa). Set TELEGRAM_DAILY_SUMMARY_ENABLED=false to disable it.
TELEGRAM_DAILY_SUMMARY_CRON=0 8 * * *
TELEGRAM_DAILY_SUMMARY_ENABLED=

# Local LLM (Ollama, running on a machine at the lab — NOT a cloud API).
# OLLAMA_BASE_URL is the lab machine's public tunnel URL reaching Ollama
# via its own auth proxy — see docs/telegram-bot-setup.md for the full
# infra setup (Ollama + auth proxy + Cloudflare Tunnel).
OLLAMA_BASE_URL=
OLLAMA_MODEL=hermes3:8b
OLLAMA_PROXY_SECRET=
