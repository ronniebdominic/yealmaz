// Ye-Almaz Dental Lab — Database Schema
// Run: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl removed — only needed for local prisma db push
  // Railway cannot reach Supabase port 5432; use SQL Editor for schema changes
}

// ── USERS ──────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role       Role
  departments String[] @default([]) // For LAB_TECH: scopes them to these department(s). Empty = unrestricted (all departments).
  phone      String?
  station    String?  // for DISPATCH/DELIVERY: which station/area they cover, for routing — matches Clinic.station
  zoneId     String?  // for DELIVERY: the broader zone (a collective of stations) they're assigned to cover
  zone       Zone?    @relation(fields: [zoneId], references: [id])
  isActive   Boolean  @default(true)
  isSharedAccount Boolean @default(false) // department/role login (e.g. "Zirconia Fitting", "Finance Department") — not a real person, so HR & Payroll excludes it from the employee list
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  casesAsReceptionist Case[]         @relation("ReceptionistCases")
  payments            Payment[]      @relation("VerifiedPayments")
  deliveries          DeliveryLog[]
  notifications       Notification[]
  assignedDeliveries  Case[]         @relation("AssignedDeliveries")
  pushSubscriptions   PushSubscription[]

  // Inventory / milling bonus
  inventoryTxnsPerformed    InventoryTransaction[]    @relation("InventoryTxnPerformedBy")
  inventoryRequestsMade     InventoryRequest[]        @relation("InventoryRequestedBy")
  inventoryRequestsReviewed InventoryRequest[]        @relation("InventoryReviewedBy")
  millingYields             MillingYield[]            @relation("MillingYieldsByUser")
  staffPoints               StaffPoints?              @relation("StaffPointsUser")
  staffRewardTransactions   StaffRewardTransaction[]  @relation("StaffRewardTxnUser")

  // HR / attendance / payroll — relation-only, no scalar columns added to
  // User itself, so existing broad User queries (dropdowns, lists) never
  // touch or expose this data unless explicitly included.
  employeeProfile          EmployeeProfile?      @relation("EmployeeProfileUser")
  attendanceEvents         AttendanceEvent[]     @relation("AttendanceEventsUser")
  attendanceEventsRecorded AttendanceEvent[]     @relation("AttendanceEventsRecordedBy")
  leaveRecords             LeaveRecord[]         @relation("LeaveRecordsUser")
  leaveRecordsRecorded     LeaveRecord[]         @relation("LeaveRecordsRecordedBy")
  payrollEntries           PayrollEntry[]        @relation("PayrollEntriesUser")
  payrollRunsCreated       PayrollRun[]          @relation("PayrollRunsCreatedBy")
  payrollAdjustmentsAdded  PayrollAdjustment[]   @relation("PayrollAdjustmentsAddedBy")

  // HR Phase 1 — Shifts / Timesheets / Overtime / Leave ledger / corrections
  managedProfiles            EmployeeProfile[]        @relation("EmployeeProfileManager")
  shiftAssignments           ShiftAssignment[]        @relation("ShiftAssignmentsUser")
  shiftAssignmentsCreated    ShiftAssignment[]        @relation("ShiftAssignmentsCreatedBy")
  timesheetEntries           TimesheetEntry[]         @relation("TimesheetEntriesUser")
  timesheetEntriesRecorded   TimesheetEntry[]         @relation("TimesheetEntriesRecordedBy")
  overtimeRecords            OvertimeRecord[]         @relation("OvertimeRecordsUser")
  overtimeRecordsApproved    OvertimeRecord[]         @relation("OvertimeRecordsApprovedBy")
  leaveLedgerEntries         LeaveLedgerEntry[]       @relation("LeaveLedgerUser")
  leaveLedgerEntriesRecorded LeaveLedgerEntry[]       @relation("LeaveLedgerRecordedBy")
  attendanceCorrections         AttendanceCorrection[] @relation("AttendanceCorrectionsUser")
  attendanceCorrectionsApproved AttendanceCorrection[] @relation("AttendanceCorrectionsApprovedBy")
  employmentHistory           EmploymentHistory[]      @relation("EmploymentHistoryUser")
  employmentHistoryChanged    EmploymentHistory[]      @relation("EmploymentHistoryChangedBy")

  // HR Phase 2 — Salary Structures / Incentives / Advances / Expenses
  salaryAssignments        EmployeeSalaryAssignment[] @relation("SalaryAssignmentsUser")
  salaryAssignmentsCreated EmployeeSalaryAssignment[] @relation("SalaryAssignmentsCreatedBy")
  incentiveAwards          IncentiveAward[]           @relation("IncentiveAwardsUser")
  incentiveAwardsApproved  IncentiveAward[]           @relation("IncentiveAwardsApprovedBy")
  advances                 EmployeeAdvance[]          @relation("AdvancesUser")
  advancesApproved         EmployeeAdvance[]          @relation("AdvancesApprovedBy")
  expenseClaims            ExpenseClaim[]             @relation("ExpenseClaimsUser")
  expenseClaimsApproved    ExpenseClaim[]             @relation("ExpenseClaimsApprovedBy")

  @@map("users")
}

enum Role {
  ADMIN
  RECEPTIONIST
  CLINIC
  DELIVERY
  DISPATCH
  LAB_TECH
  FINANCE
  INVENTORY_MANAGER
  HR_MANAGER
  FINANCE_AP
  FINANCE_CASHIER
}

// ── ZONES ──────────────────────────────────────────────
// A zone is a collective of stations (e.g. "East Zone" covers the Bole,
// CMC and Megenagna stations) — a coarser grouping so Dispatch can assign a
// delivery partner to a whole area rather than one station at a time.
model Zone {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinics Clinic[]
  users   User[]

  @@map("zones")
}

// ── CLINICS ────────────────────────────────────────────
model Clinic {
  id        String   @id @default(uuid())
  code      String?  @unique
  name      String
  station   String?
  zoneId    String?  // the zone (collective of stations) this clinic's station falls under
  zone      Zone?    @relation(fields: [zoneId], references: [id])
  email     String?  @unique
  phone     String?
  address   String?
  password  String
  isActive    Boolean  @default(true)
  isExcluded  Boolean  @default(false)

  // Trusted-partner billing schedule (finance generates consolidated bills)
  billingCycle  String?   @default("NONE") // NONE | WEEKLY | FORTNIGHTLY | MONTHLY | CUSTOM
  billingAnchor Int?                        // day-of-week (0-6) for weekly/fortnightly, day-of-month (1-28) for monthly
  lastBilledAt  DateTime?                   // when finance last generated a bill for this clinic

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases             Case[]
  pushSubscriptions PushSubscription[]
  clinicPoints      ClinicPoints?
  rewardTransactions RewardTransaction[]
  rewardRedemptions  RewardRedemption[]

  @@map("clinics")
}

// ── CASES ──────────────────────────────────────────────
model Case {
  id              String      @id @default(uuid())
  caseNumber      String?     @unique // assigned on acceptance; null for phone orders before acceptance
  patientName     String
  patientAge      Int?
  doctorName      String?     // referring doctor / dentist
  doctorPhone     String?
  patientGender   String?     // "Male" | "Female"
  workType        String      // e.g. Crown, Bridge, Denture, Aligner
  toothNumbers    String?     // e.g. "14, 15, 16"
  units           Int?        // count of tooth numbers (or manual for legacy data)
  deliveryDate    DateTime?   // actual date the case was delivered to clinic
  shade           String?     // e.g. A2, B1
  notes           String?
  remake          Boolean     @default(false)
  redo            Boolean     @default(false)
  remakeReason    String?
  isRedo          Boolean     @default(false) // redo/replacement of an existing in-mouth restoration — charged at 50%
  dueDate         DateTime?
  status          CaseStatus  @default(CASE_ACCEPTED)
  qrCodeUrl       String?     // URL of the generated QR image
  qrCodeData      String?     // The encoded URL in the QR

  // Delivery
  deliveryType    DeliveryType  @default(NORMAL)

  // Payment
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Float?

  // Relations
  clinicId        String
  clinic          Clinic      @relation(fields: [clinicId], references: [id])
  receptionistId  String?
  receptionist    User?       @relation("ReceptionistCases", fields: [receptionistId], references: [id])
  assignedDeliveryId String?
  assignedDelivery   User?    @relation("AssignedDeliveries", fields: [assignedDeliveryId], references: [id])

  // Remake/redo lineage — this case gets its OWN scan number (never reuses the
  // original's), but references the case it's a remake/redo of, like a branch
  // pointing back to its parent. Set at acceptance time by the receptionist.
  originalCaseId  String?
  originalCase    Case?       @relation("CaseLineage", fields: [originalCaseId], references: [id])
  remakes         Case[]      @relation("CaseLineage")

  // Shared UUID stamped on every case created together in one multi-item
  // "New Case" submission (e.g. 2 Zirconia + 1 PFM for the same patient
  // visit) — each item is still its own independently-tracked Case. Null
  // for ordinary single-item cases. No relation — just a lookup key via
  // GET /cases?orderGroupId=.
  orderGroupId    String?

  stages             CaseStage[]
  payment            Payment?
  deliveryLogs       DeliveryLog[]
  notifications      Notification[]
  rewardTransactions RewardTransaction[]
  comments           CaseComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([dueDate])
  @@index([deliveryDate])
  @@index([assignedDeliveryId])
  @@index([originalCaseId])
  @@index([orderGroupId])
  @@map("cases")
}

enum CaseStatus {
  // Intake — pickup from clinic
  PENDING_PICKUP      // case submitted; waiting for dispatch to assign pickup
  PICKUP_ASSIGNED     // delivery exec assigned to collect impression from clinic

  // Case received at lab
  CASE_ACCEPTED

  // Model preparation
  PLASTER_DEPARTMENT
  MARGIN_DEPARTMENT

  // Digital CAD/CAM
  SCANNING
  DESIGNING

  // Manufacturing
  MILLING_SINTERING
  RESIN_3D_PRINTING
  METAL_3D_PRINTING

  // Ceramic & finishing
  METAL_FINISHING
  OPAQUE_APPLICATION
  CERAMIC_LAYERING
  ZIRCONIA_FITTING_FINISHING
  GLAZING
  THERMO_PRESS
  TRIMMING

  // Finalization
  QUALITY_CHECK
  PAYMENT_INVOICING

  // Dispatch
  READY_TO_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED

  // Exception states
  ON_HOLD
  REMAKE
  CANCELLED

  // Receptionist review states
  UNDER_REVIEW   // needs more info from dentist before acceptance
  REJECTED       // receptionist rejected the case
}

enum DeliveryType {
  NORMAL
  EXPRESS
}

enum PaymentStatus {
  PENDING              // No payment request yet
  PAYMENT_REQUESTED    // Finance sent amount to clinic, awaiting screenshot
  SCREENSHOT_UPLOADED  // Clinic uploaded screenshot
  VERIFIED             // Finance approved — invoice auto-issued
  REJECTED             // Finance rejected (needs re-upload)
}

// ── CASE STAGES (QR scan history) ──────────────────────
model CaseStage {
  id          String    @id @default(uuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id])
  stageName   CaseStatus
  scannedAt   DateTime  @default(now())
  scannedBy   String?   // name or user ID of who scanned
  location    String?   // optional lab section name
  notes       String?

  @@index([caseId])
  @@map("case_stages")
}

// ── CASE COMMENTS (receptionist / staff notes thread) ──
model CaseComment {
  id         String   @id @default(uuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id])
  body       String
  authorName String?  // name of the staff member who wrote it
  authorRole String?  // their role at the time
  createdAt  DateTime @default(now())

  @@index([caseId])
  @@map("case_comments")
}

// ── PAYMENTS ───────────────────────────────────────────
model Payment {
  id              String        @id @default(uuid())
  caseId          String        @unique
  case            Case          @relation(fields: [caseId], references: [id])
  screenshotUrl   String?       // Cloudinary URL
  amount          Float?        // full amount due for this case
  amountReceived  Float?        // partial amount already collected (status stays PENDING until amount is met in full)
  taxWithheld     Float?        // withholding tax the clinic deducted & filed to the government directly — NOT owed to us, excluded from Outstanding by virtue of status becoming VERIFIED
  status          PaymentStatus @default(PENDING)
  rejectionReason String?
  uploadedAt      DateTime?
  verifiedAt      DateTime?
  verifiedById    String?
  verifiedBy      User?         @relation("VerifiedPayments", fields: [verifiedById], references: [id])

  invoiceNumber   String?       @unique
  invoiceIssuedAt DateTime?
  invoiceNotes    String?
  fsNumber        String?       // manually entered FS number from the clinic's paper sales-invoice/fiscal receipt

  // Chapa online payment
  chapaTxRef       String? @unique
  chapaCheckoutUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([verifiedAt])
  @@map("payments")
}

// ── DELIVERY LOGS ──────────────────────────────────────
model DeliveryLog {
  id           String   @id @default(uuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id])
  deliveryById String
  deliveredBy  User     @relation(fields: [deliveryById], references: [id])
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  signature    String?  // optional base64 or URL
  notes        String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("delivery_logs")
}

// ── WORK TYPE PRICES ───────────────────────────────────
model WorkTypePrice {
  id                  String   @id @default(uuid())
  workType            String   @unique
  price               Float
  durationDays        Int?
  expressPrice        Float?
  expressDurationDays Int?
  isFlatRate          Boolean  @default(false) // priced per case/dentition, never multiplied by unit count (e.g. Night Guard, Retainer)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("work_type_prices")
}

// ── PUSH SUBSCRIPTIONS ─────────────────────────────────
// Exactly one of clinicId/userId is set per row (enforced in app code, not
// the DB) — clinicId for the clinic app, userId for staff (currently just
// DELIVERY) subscribing from the receptionist web app.
model PushSubscription {
  id        String   @id @default(uuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// ── NOTIFICATIONS ──────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([caseId])
  @@map("notifications")
}

// ── REWARDS ────────────────────────────────────────────
model RewardSetting {
  id            String   @id @default(uuid())
  pointsPerCase Int      @default(10)
  updatedAt     DateTime @updatedAt
  @@map("reward_settings")
}

model ClinicPoints {
  id            String   @id @default(uuid())
  clinicId      String   @unique
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  totalEarned   Int      @default(0)
  totalRedeemed Int      @default(0)
  updatedAt     DateTime @updatedAt
  @@map("clinic_points")
}

model RewardTransaction {
  id          String   @id @default(uuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  type        String   // EARN | REDEEM
  points      Int
  description String
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  createdAt   DateTime @default(now())
  @@map("reward_transactions")
}

model RewardItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  pointsCost  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  redemptions RewardRedemption[]
  @@map("reward_items")
}

model RewardRedemption {
  id           String     @id @default(uuid())
  clinicId     String
  clinic       Clinic     @relation(fields: [clinicId], references: [id])
  rewardItemId String
  rewardItem   RewardItem @relation(fields: [rewardItemId], references: [id])
  pointsSpent  Int
  status       String     @default("PENDING")
  adminNote    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  @@map("reward_redemptions")
}

// ── INVENTORY ──────────────────────────────────────────
model InventoryItem {
  id               String   @id @default(uuid())
  name             String
  unit             String                       // free text: "pcs", "box", "kg"
  quantityOnHand   Int      @default(0)
  reorderThreshold Int?                          // null = no low-stock alert
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions InventoryTransaction[]
  requests     InventoryRequest[]
  @@map("inventory_items")
}

enum InventoryTxnType {
  RESTOCK
  ISSUED
  ADJUSTMENT
}

model InventoryTransaction {
  id               String            @id @default(uuid())
  itemId           String
  item             InventoryItem     @relation(fields: [itemId], references: [id])
  type             InventoryTxnType
  quantity         Int               // SIGNED delta: RESTOCK/ADJUSTMENT-up positive, ISSUED/ADJUSTMENT-down negative
  relatedRequestId String?
  relatedRequest   InventoryRequest? @relation(fields: [relatedRequestId], references: [id])
  performedById    String
  performedBy      User              @relation("InventoryTxnPerformedBy", fields: [performedById], references: [id])
  note             String?
  createdAt        DateTime          @default(now())

  @@index([itemId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

enum InventoryRequestStatus {
  PENDING
  FULFILLED
  REJECTED
}

model InventoryRequest {
  id                String                 @id @default(uuid())
  itemId            String
  item              InventoryItem          @relation(fields: [itemId], references: [id])
  requestedById     String
  requestedBy       User                   @relation("InventoryRequestedBy", fields: [requestedById], references: [id])
  department        String                 // picked by the requester at submit time
  quantityRequested Int
  quantityApproved  Int?
  status            InventoryRequestStatus @default(PENDING)
  requesterNote     String?
  reviewedById      String?
  reviewedBy        User?                  @relation("InventoryReviewedBy", fields: [reviewedById], references: [id])
  reviewNote        String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  transactions InventoryTransaction[]
  @@index([status])
  @@index([requestedById])
  @@map("inventory_requests")
}

// ── MILLING BONUS ──────────────────────────────────────
// Crown-yield tracking is deliberately caseless: one sintering blank can
// produce crowns for several different cases in one firing, and the case
// scan flow (scan.js) has no batch/blank concept linking them. A lab tech
// logs blank -> crown yield as an independent event, not tied to any case.
model MillingYield {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation("MillingYieldsByUser", fields: [userId], references: [id])
  blanksUsed     Int      @default(1)
  crownsProduced Int
  bonusPoints    Int      @default(0)   // computed against MillingBonusSetting and frozen at write time
  createdAt      DateTime @default(now())

  rewardTransactions StaffRewardTransaction[]
  @@index([userId])
  @@index([createdAt])
  @@map("milling_yields")
}

model MillingBonusSetting {
  id                  String   @id @default(uuid())
  minCrownsPerBlank   Int      @default(30)  // bonus only when crownsProduced > this
  pointsPerExtraCrown Int      @default(5)   // bonus = (crownsProduced - minCrownsPerBlank) * pointsPerExtraCrown
  updatedAt           DateTime @updatedAt
  @@map("milling_bonus_settings")
}

model StaffPoints {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation("StaffPointsUser", fields: [userId], references: [id])
  totalEarned Int      @default(0)
  updatedAt   DateTime @updatedAt
  @@map("staff_points")
}

model StaffRewardTransaction {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation("StaffRewardTxnUser", fields: [userId], references: [id])
  points        Int
  description   String
  sourceYieldId String?
  sourceYield   MillingYield? @relation(fields: [sourceYieldId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([userId])
  @@map("staff_reward_transactions")
}

// ── EMPLOYEE / ATTENDANCE / PAYROLL ────────────────────
// Kept strictly separate from User: EmployeeProfile is the only place
// sensitive employment/financial data lives, so the many existing broad
// User queries elsewhere in the app (dropdowns, staff lists) never touch
// or risk exposing it.
enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

model EmployeeProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation("EmployeeProfileUser", fields: [userId], references: [id])
  employeeCode     String?          @unique // maps to whatever ID a future biometric device uses
  position         String?
  hireDate         DateTime?
  baseSalary       Float?
  bankName         String?
  bankAccount      String?
  employmentStatus EmploymentStatus @default(ACTIVE)

  // Personal info (Phase 1 HR expansion)
  photoUrl              String?
  preferredName         String?
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?

  // Employment info (Phase 1 HR expansion)
  employmentType   EmploymentType?
  confirmationDate DateTime?
  probationEndDate DateTime?
  noticePeriodDays Int?
  endDate          DateTime? // termination/last-day date
  workLocation     String?   // free-text internal work area — this is a single-lab system, not a branch model
  managerId        String?
  manager          User?     @relation("EmployeeProfileManager", fields: [managerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_profiles")
}

enum AttendanceEventType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum AttendanceSource {
  BIOMETRIC
  MANUAL
  GEOFENCE // self-service via the app — CLOCK_IN/CLOCK_OUT are geofenced to ATTENDANCE_RADIUS_METERS of the lab; BREAK_START/BREAK_END are not (agents are on the road)
}

// Caseless, caseless-adjacent ledger of raw clock events. Biometric-device
// integration is not live yet — POST /api/attendance/events is built and
// secured, ready to receive real device pushes once one is chosen; most
// rows today come from HR's manual entry (source: MANUAL) or delivery
// agents' self-service geofenced clock-in/out (source: GEOFENCE).
model AttendanceEvent {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation("AttendanceEventsUser", fields: [userId], references: [id])
  timestamp      DateTime
  type           AttendanceEventType
  source         AttendanceSource
  deviceId       String?
  recordedById   String?             // HR staff who manually entered it; null for biometric/geofence-sourced rows
  recordedBy     User?               @relation("AttendanceEventsRecordedBy", fields: [recordedById], references: [id])
  note           String?
  // Self-reported location backing a GEOFENCE event — an audit trail HR can
  // review, not a spoofing-proof guarantee.
  latitude       Float?
  longitude      Float?
  distanceMeters Float?
  createdAt      DateTime            @default(now())

  @@index([userId])
  @@index([timestamp])
  @@map("attendance_events")
}

enum LeaveStatus {
  APPROVED
  REJECTED
  PENDING // self-service requests only — HR's own direct entries skip straight to APPROVED/REJECTED
}

enum LeaveDayPortion {
  FULL
  HALF_AM
  HALF_PM
}

// HR logs these directly on an employee's behalf (v1 has no self-service
// submission flow) — status defaults APPROVED since HR is the one
// entering it authoritatively; REJECTED exists to correct a mistaken entry.
model LeaveRecord {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation("LeaveRecordsUser", fields: [userId], references: [id])
  fromDate     DateTime
  toDate       DateTime
  reason       String?
  status       LeaveStatus @default(APPROVED)
  recordedById String
  recordedBy   User        @relation("LeaveRecordsRecordedBy", fields: [recordedById], references: [id])
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Phase 1 HR expansion — nullable/defaulted so existing rows keep working
  leaveTypeId String?
  leaveType   LeaveType?      @relation(fields: [leaveTypeId], references: [id])
  dayPortion  LeaveDayPortion @default(FULL)

  ledgerEntries LeaveLedgerEntry[] @relation("LedgerFromLeaveRecord")

  @@index([userId])
  @@map("leave_records")
}

// Phase 2 workflow: DRAFT → PROCESSING → REVIEW → APPROVED → PAID →
// FINALIZED ("Closed" in the UI — kept as FINALIZED rather than renamed to
// avoid an enum-value migration; existing FINALIZED rows from Phase 1 are
// unaffected). Only the finalize endpoint's DRAFT-only adjustment guard
// exists today — full transition validation lives in payroll.js.
enum PayrollRunStatus {
  DRAFT
  PROCESSING
  REVIEW
  APPROVED
  PAID
  FINALIZED
}

model PayrollRun {
  id          String           @id @default(uuid())
  periodMonth Int              // 1-12
  periodYear  Int
  status      PayrollRunStatus @default(DRAFT)
  createdById String
  createdBy   User             @relation("PayrollRunsCreatedBy", fields: [createdById], references: [id])
  finalizedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  entries PayrollEntry[]

  @@unique([periodMonth, periodYear])
  @@map("payroll_runs")
}

// netPay = baseSalarySnapshot + sum(adjustments), rounded to 2dp, recomputed
// whenever an adjustment is added — the only place money moves. No
// automatic tax/pension/attendance deduction is ever computed; every
// deduction (including an attendance-based one, if HR wants one) is a
// manually entered PayrollAdjustment row.
model PayrollEntry {
  id                 String   @id @default(uuid())
  runId              String
  run                PayrollRun @relation(fields: [runId], references: [id])
  userId             String
  user               User     @relation("PayrollEntriesUser", fields: [userId], references: [id])
  baseSalarySnapshot Float    // frozen from EmployeeProfile.baseSalary at run-creation time
  netPay             Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  adjustments PayrollAdjustment[]

  @@index([runId])
  @@index([userId])
  @@map("payroll_entries")
}

enum PayrollAdjustmentType {
  ALLOWANCE
  DEDUCTION
  BONUS
  CORRECTION
  RETROACTIVE
  REIMBURSEMENT
  OVERTIME
  INCENTIVE
  ADVANCE_REPAYMENT
  OTHER
}

model PayrollAdjustment {
  id            String                @id @default(uuid())
  entryId       String
  entry         PayrollEntry          @relation(fields: [entryId], references: [id])
  label         String                // e.g. "Attendance deduction", "Transport allowance", "Income tax"
  amount        Float                 // signed: + bonus, - deduction
  type          PayrollAdjustmentType @default(OTHER) // defaults OTHER for pre-Phase-2 rows
  autoGenerated Boolean               @default(false) // true for salary-structure/overtime/advance/expense/incentive rows created by run-generation, vs HR's manual entries
  addedById     String
  addedBy       User                  @relation("PayrollAdjustmentsAddedBy", fields: [addedById], references: [id])
  createdAt     DateTime              @default(now())

  @@index([entryId])
  @@map("payroll_adjustments")
}

// ── PHASE 2: SALARY STRUCTURES ──────────────────────────
// "Do not hard-code salary calculations" — components are configurable
// name+category+calc-method rows, assembled into named structures, and
// assigned to employees. FORMULA-style flexibility is deliberately
// constrained to a small safe set of calc types (no arbitrary expression
// eval) rather than a real formula engine.
enum SalaryComponentCategory {
  EARNING
  DEDUCTION
}

enum SalaryCalcType {
  FIXED
  PERCENT_OF_BASIC
  PER_OVERTIME_HOUR
  PER_UNIT
}

model SalaryComponent {
  id            String                  @id @default(uuid())
  name          String                  // e.g. "Housing Allowance", "Transport", "Unpaid Leave Deduction"
  category      SalaryComponentCategory
  calcType      SalaryCalcType          @default(FIXED)
  defaultAmount Float                   @default(0) // fixed Br, or the % for PERCENT_OF_BASIC, or the rate for PER_*
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  structureItems SalaryStructureItem[]

  @@map("salary_components")
}

model SalaryStructure {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       SalaryStructureItem[]
  assignments EmployeeSalaryAssignment[]

  @@map("salary_structures")
}

model SalaryStructureItem {
  id          String          @id @default(uuid())
  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id])
  componentId String
  component   SalaryComponent @relation(fields: [componentId], references: [id])
  amount      Float?          // overrides component.defaultAmount when set
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  @@unique([structureId, componentId])
  @@index([structureId])
  @@map("salary_structure_items")
}

// Same never-overwrite assignment-history pattern as ShiftAssignment —
// changing an employee's structure closes out the open row and inserts a
// new one.
model EmployeeSalaryAssignment {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation("SalaryAssignmentsUser", fields: [userId], references: [id])
  structureId   String
  structure     SalaryStructure @relation(fields: [structureId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdById   String
  createdBy     User            @relation("SalaryAssignmentsCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@map("employee_salary_assignments")
}

// ── PHASE 2: INCENTIVES ─────────────────────────────────
// "Do not hard-code incentive rules" — a rule defines a metric + target +
// reward; actual metric values are read from existing data (Lab
// Performance scans, Attendance, etc.) at award-computation time, never
// duplicated into a parallel tracking system.
enum IncentiveMetric {
  PRODUCTION_UNITS
  CASES
  PRODUCTIVITY
  ATTENDANCE
  QUALITY
  QC_PASS_RATE
  REMAKE_RATE
  REVENUE
  CUSTOM
}

enum IncentiveRewardType {
  FIXED
  PER_UNIT_OVER_TARGET
  PERCENTAGE
}

model IncentiveRule {
  id           String              @id @default(uuid())
  name         String
  metric       IncentiveMetric
  targetValue  Float
  rewardType   IncentiveRewardType @default(FIXED)
  rewardAmount Float
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  awards IncentiveAward[]

  @@map("incentive_rules")
}

enum IncentiveAwardStatus {
  PENDING
  APPROVED
  PAID
}

model IncentiveAward {
  id             String                @id @default(uuid())
  userId         String
  user           User                  @relation("IncentiveAwardsUser", fields: [userId], references: [id])
  ruleId         String
  rule           IncentiveRule         @relation(fields: [ruleId], references: [id])
  periodMonth    Int
  periodYear     Int
  actualValue    Float
  targetValue    Float
  awardedAmount  Float
  status         IncentiveAwardStatus  @default(PENDING)
  payrollEntryId String?
  approvedById   String?
  approvedBy     User?                 @relation("IncentiveAwardsApprovedBy", fields: [approvedById], references: [id])
  createdAt      DateTime              @default(now())

  @@unique([userId, ruleId, periodMonth, periodYear])
  @@index([userId])
  @@map("incentive_awards")
}

// ── PHASE 2: ADVANCES & LOANS ────────────────────────────
enum AdvanceType {
  ADVANCE
  LOAN
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
}

model EmployeeAdvance {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation("AdvancesUser", fields: [userId], references: [id])
  type               AdvanceType   @default(ADVANCE)
  amount             Float
  installmentAmount  Float
  outstandingBalance Float
  reason             String?
  status             AdvanceStatus @default(PENDING)
  requestedAt        DateTime      @default(now())
  approvedById       String?
  approvedBy         User?         @relation("AdvancesApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  repayments AdvanceRepayment[]

  @@index([userId])
  @@map("employee_advances")
}

model AdvanceRepayment {
  id             String          @id @default(uuid())
  advanceId      String
  advance        EmployeeAdvance @relation(fields: [advanceId], references: [id])
  payrollEntryId String?
  amount         Float
  date           DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([advanceId])
  @@map("advance_repayments")
}

// ── PHASE 2: EXPENSES ────────────────────────────────────
enum ExpenseStatus {
  SUBMITTED
  MANAGER_APPROVED
  FINANCE_APPROVED
  REJECTED
  REIMBURSED
}

model ExpenseClaim {
  id                         String        @id @default(uuid())
  userId                     String
  user                       User          @relation("ExpenseClaimsUser", fields: [userId], references: [id])
  category                   String
  date                       DateTime
  amount                     Float
  description                String?
  receiptUrl                 String?
  status                     ExpenseStatus @default(SUBMITTED)
  approvedById               String?
  approvedBy                 User?         @relation("ExpenseClaimsApprovedBy", fields: [approvedById], references: [id])
  approvedAt                 DateTime?
  reimbursedInPayrollEntryId String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  @@index([userId])
  @@map("expense_claims")
}

// ── SHIFTS ─────────────────────────────────────────────
enum ShiftHolidayHandling {
  NO_WORK
  OPTIONAL
  WORK
}

model Shift {
  id                             String               @id @default(uuid())
  name                           String
  startTime                      String               // "HH:mm", interpreted in server TZ (Africa/Addis_Ababa)
  endTime                        String
  breakMinutes                   Int                  @default(0)
  gracePeriodMinutes             Int                  @default(0)
  lateThresholdMinutes           Int                  @default(0) // additional buffer after grace before "Late"
  earlyDepartureThresholdMinutes Int                  @default(0)
  overtimeThresholdMinutes       Int?                 // null = derive from (end-start-break)
  workingDays                    Int[]                @default([1, 2, 3, 4, 5]) // 0=Sun..6=Sat
  holidayHandling                ShiftHolidayHandling @default(NO_WORK)
  isActive                       Boolean              @default(true) // soft-delete only — ShiftAssignment history references it
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt

  assignments     ShiftAssignment[]
  overtimeRecords OvertimeRecord[]

  @@map("shifts")
}

// Changing an employee's shift closes out the currently-open assignment
// (sets effectiveTo) and inserts a new row — never overwrites, so shift
// history is always reconstructable.
model ShiftAssignment {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation("ShiftAssignmentsUser", fields: [userId], references: [id])
  shiftId       String
  shift         Shift     @relation(fields: [shiftId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime? // null = currently active
  note          String?
  createdById   String
  createdBy     User      @relation("ShiftAssignmentsCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([shiftId])
  @@map("shift_assignments")
}

// ── TIMESHEETS ─────────────────────────────────────────
enum TimesheetStatus {
  APPROVED
  REJECTED
}

// Manual time-activity entries — for LAB_TECH users this is a supplement to
// (not a replacement for) their existing CaseStage scan history, which
// GET /api/timesheets/lab-tech-enrichment surfaces read-only alongside
// these rows.
model TimesheetEntry {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation("TimesheetEntriesUser", fields: [userId], references: [id])
  date         DateTime        // local calendar day
  startTime    DateTime
  endTime      DateTime
  category     String          // one of the hardcoded PRODUCTIVE/NON_PRODUCTIVE constants in timesheets.js
  productive   Boolean
  notes        String?
  status       TimesheetStatus @default(APPROVED) // HR enters authoritatively, same posture as LeaveRecord
  recordedById String
  recordedBy   User            @relation("TimesheetEntriesRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([date])
  @@map("timesheet_entries")
}

// ── OVERTIME ───────────────────────────────────────────
enum OvertimeSource {
  AUTO_DETECTED
  MANUAL
}

enum OvertimeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OvertimePayrollStatus {
  UNPAID
  PAID
}

// Phase 1 tracks hours + approval only — payrollStatus stays UNPAID with no
// automatic PayrollAdjustment creation until Phase 2 wires in Salary
// Structures.
model OvertimeRecord {
  id             String                 @id @default(uuid())
  userId         String
  user           User                   @relation("OvertimeRecordsUser", fields: [userId], references: [id])
  date           DateTime
  shiftId        String?
  shift          Shift?                 @relation(fields: [shiftId], references: [id])
  regularHours   Float
  overtimeHours  Float
  reason         String?
  source         OvertimeSource         @default(AUTO_DETECTED)
  approvalStatus OvertimeApprovalStatus @default(PENDING)
  approvedById   String?
  approvedBy     User?                  @relation("OvertimeRecordsApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  payrollStatus  OvertimePayrollStatus  @default(UNPAID)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([userId, date]) // idempotent auto-detection
  @@index([userId])
  @@map("overtime_records")
}

// ── LEAVE TYPES / BALANCE LEDGER / HOLIDAYS ─────────────
model LeaveType {
  id                String   @id @default(uuid())
  name              String   @unique
  defaultAnnualDays Float?
  requiresApproval  Boolean  @default(true)
  isPaid            Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leaveRecords  LeaveRecord[]
  ledgerEntries LeaveLedgerEntry[]

  @@map("leave_types")
}

enum LeaveLedgerTxnType {
  ENTITLEMENT
  USED
  CARRY_FORWARD
  EXPIRED
  ADJUSTMENT
}

// Balance is always sum(days) for a user+leaveType — never a single stored
// number, so entitlement/usage/carry-forward/adjustment stay auditable.
model LeaveLedgerEntry {
  id                    String             @id @default(uuid())
  userId                String
  user                  User               @relation("LeaveLedgerUser", fields: [userId], references: [id])
  leaveTypeId           String
  leaveType             LeaveType          @relation(fields: [leaveTypeId], references: [id])
  transactionType       LeaveLedgerTxnType
  days                  Float              // signed: negative for USED/EXPIRED, positive for ENTITLEMENT/CARRY_FORWARD
  effectiveDate         DateTime
  relatedLeaveRecordId  String?
  relatedLeaveRecord    LeaveRecord?       @relation("LedgerFromLeaveRecord", fields: [relatedLeaveRecordId], references: [id])
  note                  String?
  recordedById          String
  recordedBy            User               @relation("LeaveLedgerRecordedBy", fields: [recordedById], references: [id])
  createdAt             DateTime           @default(now())

  @@index([userId])
  @@index([leaveTypeId])
  @@map("leave_ledger_entries")
}

enum HolidayType {
  COMPANY
  PUBLIC
}

model Holiday {
  id        String      @id @default(uuid())
  date      DateTime    @unique
  name      String
  type      HolidayType @default(PUBLIC)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("holidays")
}

// ── ATTENDANCE CORRECTIONS / EMPLOYMENT HISTORY ─────────
// Additive audit record — AttendanceEvent rows are never edited or deleted.
// original*/corrected* are both stored so nothing about a correction is
// ever ambiguous or silently lost.
model AttendanceCorrection {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation("AttendanceCorrectionsUser", fields: [userId], references: [id])
  date              DateTime
  originalClockIn   DateTime?
  originalClockOut  DateTime?
  correctedClockIn  DateTime?
  correctedClockOut DateTime?
  reason            String
  approvedById      String
  approvedBy        User     @relation("AttendanceCorrectionsApprovedBy", fields: [approvedById], references: [id])
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([date])
  @@map("attendance_corrections")
}

// Lightweight change log — written automatically by PATCH
// /employees/:userId/profile when position/employmentStatus/managerId change.
model EmploymentHistory {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation("EmploymentHistoryUser", fields: [userId], references: [id])
  field         String   // 'position' | 'employmentStatus' | 'managerId' | ...
  oldValue      String?
  newValue      String?
  effectiveDate DateTime @default(now())
  changedById   String
  changedBy     User     @relation("EmploymentHistoryChangedBy", fields: [changedById], references: [id])
  note          String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("employment_history")
}

// ── GOOGLE SHEETS SYNC ─────────────────────────────────
// Tracks which spreadsheet row a case occupies, so the sync webhook can update
// the existing row (upsert) instead of re-scanning the whole sheet every time.
model SheetSyncRow {
  id        String   @id @default(uuid())
  caseId    String   @unique
  rowNumber Int
  updatedAt DateTime @updatedAt
  @@map("sheet_sync_rows")
}
