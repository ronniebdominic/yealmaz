// Ye-Almaz Dental Lab — Database Schema
// Run: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl removed — only needed for local prisma db push
  // Railway cannot reach Supabase port 5432; use SQL Editor for schema changes
}

// ── USERS ──────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role       Role
  departments String[] @default([]) // For LAB_TECH: scopes them to these department(s). Empty = unrestricted (all departments).
  phone      String?
  isActive   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  casesAsReceptionist Case[]         @relation("ReceptionistCases")
  payments            Payment[]      @relation("VerifiedPayments")
  deliveries          DeliveryLog[]
  notifications       Notification[]
  assignedDeliveries  Case[]         @relation("AssignedDeliveries")

  @@map("users")
}

enum Role {
  ADMIN
  RECEPTIONIST
  CLINIC
  DELIVERY
  DISPATCH
  LAB_TECH
  FINANCE
}

// ── CLINICS ────────────────────────────────────────────
model Clinic {
  id        String   @id @default(uuid())
  code      String?  @unique
  name      String
  station   String?
  email     String?  @unique
  phone     String?
  address   String?
  password  String
  isActive    Boolean  @default(true)
  isExcluded  Boolean  @default(false)

  // Trusted-partner billing schedule (finance generates consolidated bills)
  billingCycle  String?   @default("NONE") // NONE | WEEKLY | FORTNIGHTLY | MONTHLY | CUSTOM
  billingAnchor Int?                        // day-of-week (0-6) for weekly/fortnightly, day-of-month (1-28) for monthly
  lastBilledAt  DateTime?                   // when finance last generated a bill for this clinic

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases             Case[]
  pushSubscriptions PushSubscription[]
  clinicPoints      ClinicPoints?
  rewardTransactions RewardTransaction[]
  rewardRedemptions  RewardRedemption[]

  @@map("clinics")
}

// ── CASES ──────────────────────────────────────────────
model Case {
  id              String      @id @default(uuid())
  caseNumber      String?     @unique // assigned on acceptance; null for phone orders before acceptance
  patientName     String
  patientAge      Int?
  doctorName      String?     // referring doctor / dentist
  doctorPhone     String?
  patientGender   String?     // "Male" | "Female"
  workType        String      // e.g. Crown, Bridge, Denture, Aligner
  toothNumbers    String?     // e.g. "14, 15, 16"
  units           Int?        // count of tooth numbers (or manual for legacy data)
  deliveryDate    DateTime?   // actual date the case was delivered to clinic
  shade           String?     // e.g. A2, B1
  notes           String?
  remake          Boolean     @default(false)
  redo            Boolean     @default(false)
  remakeReason    String?
  isRedo          Boolean     @default(false) // redo/replacement of an existing in-mouth restoration — charged at 50%
  dueDate         DateTime?
  status          CaseStatus  @default(CASE_ACCEPTED)
  qrCodeUrl       String?     // URL of the generated QR image
  qrCodeData      String?     // The encoded URL in the QR

  // Delivery
  deliveryType    DeliveryType  @default(NORMAL)

  // Payment
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Float?

  // Relations
  clinicId        String
  clinic          Clinic      @relation(fields: [clinicId], references: [id])
  receptionistId  String?
  receptionist    User?       @relation("ReceptionistCases", fields: [receptionistId], references: [id])
  assignedDeliveryId String?
  assignedDelivery   User?    @relation("AssignedDeliveries", fields: [assignedDeliveryId], references: [id])

  stages             CaseStage[]
  payment            Payment?
  deliveryLogs       DeliveryLog[]
  notifications      Notification[]
  rewardTransactions RewardTransaction[]
  comments           CaseComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([dueDate])
  @@index([deliveryDate])
  @@index([assignedDeliveryId])
  @@map("cases")
}

enum CaseStatus {
  // Intake — pickup from clinic
  PENDING_PICKUP      // case submitted; waiting for dispatch to assign pickup
  PICKUP_ASSIGNED     // delivery exec assigned to collect impression from clinic

  // Case received at lab
  CASE_ACCEPTED

  // Model preparation
  PLASTER_DEPARTMENT
  MARGIN_DEPARTMENT

  // Digital CAD/CAM
  SCANNING
  DESIGNING

  // Manufacturing
  MILLING_SINTERING
  RESIN_3D_PRINTING
  METAL_3D_PRINTING

  // Ceramic & finishing
  METAL_FINISHING
  OPAQUE_APPLICATION
  CERAMIC_LAYERING
  ZIRCONIA_FITTING_FINISHING
  GLAZING
  THERMO_PRESS
  TRIMMING

  // Finalization
  QUALITY_CHECK
  PAYMENT_INVOICING

  // Dispatch
  READY_TO_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED

  // Exception states
  ON_HOLD
  REMAKE
  CANCELLED

  // Receptionist review states
  UNDER_REVIEW   // needs more info from dentist before acceptance
  REJECTED       // receptionist rejected the case
}

enum DeliveryType {
  NORMAL
  EXPRESS
}

enum PaymentStatus {
  PENDING              // No payment request yet
  PAYMENT_REQUESTED    // Finance sent amount to clinic, awaiting screenshot
  SCREENSHOT_UPLOADED  // Clinic uploaded screenshot
  VERIFIED             // Finance approved — invoice auto-issued
  REJECTED             // Finance rejected (needs re-upload)
}

// ── CASE STAGES (QR scan history) ──────────────────────
model CaseStage {
  id          String    @id @default(uuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id])
  stageName   CaseStatus
  scannedAt   DateTime  @default(now())
  scannedBy   String?   // name or user ID of who scanned
  location    String?   // optional lab section name
  notes       String?

  @@index([caseId])
  @@map("case_stages")
}

// ── CASE COMMENTS (receptionist / staff notes thread) ──
model CaseComment {
  id         String   @id @default(uuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id])
  body       String
  authorName String?  // name of the staff member who wrote it
  authorRole String?  // their role at the time
  createdAt  DateTime @default(now())

  @@index([caseId])
  @@map("case_comments")
}

// ── PAYMENTS ───────────────────────────────────────────
model Payment {
  id              String        @id @default(uuid())
  caseId          String        @unique
  case            Case          @relation(fields: [caseId], references: [id])
  screenshotUrl   String?       // Cloudinary URL
  amount          Float?        // full amount due for this case
  amountReceived  Float?        // partial amount already collected (status stays PENDING until amount is met in full)
  status          PaymentStatus @default(PENDING)
  rejectionReason String?
  uploadedAt      DateTime?
  verifiedAt      DateTime?
  verifiedById    String?
  verifiedBy      User?         @relation("VerifiedPayments", fields: [verifiedById], references: [id])

  invoiceNumber   String?       @unique
  invoiceIssuedAt DateTime?
  invoiceNotes    String?

  // Chapa online payment
  chapaTxRef       String? @unique
  chapaCheckoutUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([verifiedAt])
  @@map("payments")
}

// ── DELIVERY LOGS ──────────────────────────────────────
model DeliveryLog {
  id           String   @id @default(uuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id])
  deliveryById String
  deliveredBy  User     @relation(fields: [deliveryById], references: [id])
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  signature    String?  // optional base64 or URL
  notes        String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("delivery_logs")
}

// ── WORK TYPE PRICES ───────────────────────────────────
model WorkTypePrice {
  id                  String   @id @default(uuid())
  workType            String   @unique
  price               Float
  durationDays        Int?
  expressPrice        Float?
  expressDurationDays Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("work_type_prices")
}

// ── PUSH SUBSCRIPTIONS ─────────────────────────────────
model PushSubscription {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// ── NOTIFICATIONS ──────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([caseId])
  @@map("notifications")
}

// ── REWARDS ────────────────────────────────────────────
model RewardSetting {
  id            String   @id @default(uuid())
  pointsPerCase Int      @default(10)
  updatedAt     DateTime @updatedAt
  @@map("reward_settings")
}

model ClinicPoints {
  id            String   @id @default(uuid())
  clinicId      String   @unique
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  totalEarned   Int      @default(0)
  totalRedeemed Int      @default(0)
  updatedAt     DateTime @updatedAt
  @@map("clinic_points")
}

model RewardTransaction {
  id          String   @id @default(uuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  type        String   // EARN | REDEEM
  points      Int
  description String
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  createdAt   DateTime @default(now())
  @@map("reward_transactions")
}

model RewardItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  pointsCost  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  redemptions RewardRedemption[]
  @@map("reward_items")
}

model RewardRedemption {
  id           String     @id @default(uuid())
  clinicId     String
  clinic       Clinic     @relation(fields: [clinicId], references: [id])
  rewardItemId String
  rewardItem   RewardItem @relation(fields: [rewardItemId], references: [id])
  pointsSpent  Int
  status       String     @default("PENDING")
  adminNote    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  @@map("reward_redemptions")
}

// ── GOOGLE SHEETS SYNC ─────────────────────────────────
// Tracks which spreadsheet row a case occupies, so the sync webhook can update
// the existing row (upsert) instead of re-scanning the whole sheet every time.
model SheetSyncRow {
  id        String   @id @default(uuid())
  caseId    String   @unique
  rowNumber Int
  updatedAt DateTime @updatedAt
  @@map("sheet_sync_rows")
}
